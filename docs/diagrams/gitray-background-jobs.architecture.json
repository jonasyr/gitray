  "cards": [
    {
      "dot": "amber",
      "title": "Eight recurring timers",
      "items": [
        "Six start on import or in a constructor, not from startApplication",
        "Importing repositoryCache alone starts disk, Redis and timer work",
        "The memory monitor ticks every second by default"
      ]
    },
    {
      "dot": "rose",
      "title": "Shutdown does not finish",
      "items": [
        "setupGracefulShutdown types its callback as () => void",
        "index.ts passes an async callback, so the promise is dropped",
        "process.exit(0) then runs: coordinator and cache shutdown are abandoned"
      ]
    },
    {
      "dot": "slate",
      "title": "Unstoppable intervals",
      "items": [
        "coordination metrics and disk index check keep no timer handle",
        "temp-dir cleanup is stoppable but stopCleanupScheduler is never called",
        "Only the metrics scheduler is actually cleared on shutdown"
      ]
    }
  ]
