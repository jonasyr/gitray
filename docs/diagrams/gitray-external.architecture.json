  "cards": [
    {
      "dot": "slate",
      "title": "Verified: nothing else",
      "items": [
        "No GitHub or GitLab API client anywhere in the backend",
        "No axios, fetch, octokit or outbound HTTP other than git itself",
        "No auth provider, object storage, email or telemetry SaaS"
      ]
    },
    {
      "dot": "emerald",
      "title": "The boundary is well guarded",
      "items": [
        "isSafeGitUrl enforces protocol, host allow-list and private-IP rejection",
        "DNS-rebinding resistant, with a dedicated verification script",
        "Applied to every route through the shared validation chains"
      ]
    },
    {
      "dot": "amber",
      "title": "Boundary caveats",
      "items": [
        "maxConcurrentProcesses is the only cap on concurrent git subprocesses",
        "Two Redis databases with independent lifecycles",
        "Filesystem is shared by clones, cache spill, locks and logs"
      ]
    }
  ]
