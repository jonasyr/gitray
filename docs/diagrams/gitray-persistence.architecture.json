  "cards": [
    {
      "dot": "slate",
      "title": "No database exists",
      "items": [
        "No SQL, ORM, migrations or entities anywhere",
        "State lives in memory, on local disk, and in Redis",
        "In-process caches, clone handles and lock files are per-process"
      ]
    },
    {
      "dot": "amber",
      "title": "Overlaps and gaps",
      "items": [
        "Summary is cached twice: db0 for 24h and tier 3 for 2h",
        "Redis keys embed ephemeral temp paths, so they never hit",
        "Clones are never refreshed once written"
      ]
    },
    {
      "dot": "rose",
      "title": "Degraded mode is worst",
      "items": [
        "Map fallback discards the TTL the other backends honour",
        "It has no size bound and never evicts on write",
        "This is the documented Redis-down path"
      ]
    }
  ]
